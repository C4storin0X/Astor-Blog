---
import Site from '../../layouts/Site.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const all=await getCollection('articles',({data})=>data.status==='Published');return all.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<Site title={entry.data.title} description={entry.data.description}><div class="shell article"><a class="inline-link" href="/articoli/">← Tutti gli articoli</a><p class="eyebrow" style="margin-top:40px">{entry.data.category||'Research'} · {entry.data.date?.toLocaleDateString('it-IT')}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><hr style="border:0;border-top:1px solid var(--line);margin:36px 0"/><div class="prose"><Content/></div></div></Site>