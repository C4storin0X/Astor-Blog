---
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const articles=await getCollection('articles',({data})=>data.status==='Published');return articles.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);
const rawVideo=entry.data.video_url||'';
let embedUrl='';
try{const parsed=new URL(rawVideo);const hostname=parsed.hostname.toLowerCase();if(['www.youtube.com','youtube.com','m.youtube.com'].includes(hostname)&&parsed.pathname==='/watch'){const id=parsed.searchParams.get('v');if(id&&/^[\w-]{11}$/.test(id))embedUrl=`https://www.youtube-nocookie.com/embed/${id}`;}else if(hostname==='youtu.be'){const id=parsed.pathname.slice(1);if(/^[\w-]{11}$/.test(id))embedUrl=`https://www.youtube-nocookie.com/embed/${id}`;}else if(hostname==='player.vimeo.com'||hostname==='vimeo.com'){const id=parsed.pathname.split('/').filter(Boolean).pop();if(id&&/^\d+$/.test(id))embedUrl=`https://player.vimeo.com/video/${id}`;}}catch{}
---
<Site title={entry.data.title} description={entry.data.description}><article class="article-shell"><a class="section-link" href="/articoli/">← Tutti gli articoli</a><header style="margin-top:35px"><span class="eyebrow">{entry.data.category||'Research'} · {entry.data.date?.toLocaleDateString('it-IT')}</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p></header>{entry.data.cover&&<img class="article-cover" src={entry.data.cover} alt={`Copertina: ${entry.data.title}`}/>}<div class="article-content"><Content/>{embedUrl&&<div class="video-wrap"><p class="meta">VIDEO DI APPROFONDIMENTO</p><iframe class="media-embed" src={embedUrl} title={`Video: ${entry.data.title}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>}{rawVideo&&!embedUrl&&/^https:\/\//.test(rawVideo)&&<p><a href={rawVideo} target="_blank" rel="noopener noreferrer">Guarda il video di riferimento ↗</a></p>}</div></article></Site>