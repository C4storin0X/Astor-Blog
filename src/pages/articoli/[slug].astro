---
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const all=await getCollection('articles',({data})=>data.status==='Published');return all.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);
---
<Site title={entry.data.title} description={entry.data.description}><div class="article"><a class="button alt" href="/articoli/">← Archive</a><div style="margin:38px 0 28px"><span class="eyebrow">{entry.data.category||'Research'} // {entry.data.date?.toLocaleDateString('it-IT')}</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p></div><div class="window prose"><Content/></div></div></Site>