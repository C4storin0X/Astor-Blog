---
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const all=await getCollection('articles',({data})=>data.status==='Published');return all.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);
---
<Site title={entry.data.title} description={entry.data.description}><div class="bg-blue-theme min-h-screen p-6 md:p-12"><div class="cyber-layout"><a href="/articoli/" class="cyber-link">← Tutti gli articoli</a><div class="cyber-article mt-10"><div class="uppercase text-xs font-black">{entry.data.category||'Research'} · {entry.data.date?.toLocaleDateString('it-IT')}</div><h1 class="text-4xl md:text-6xl font-black my-6">{entry.data.title}</h1><p class="text-xl font-semibold mb-8">{entry.data.description}</p><hr class="border-black border-t-4 my-6"/><div class="prose prose-slate max-w-none"><Content/></div></div></div></div></Site>