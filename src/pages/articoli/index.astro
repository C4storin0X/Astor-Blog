---
import Site from '../../layouts/Site.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>data.status==='Published')).sort((a,b)=>(b.data.date?.getTime()||0)-(a.data.date?.getTime()||0));
---
<Site title="Articoli"><div class="wrap"><section class="page-head"><span class="eyebrow">01 // RESEARCH ARCHIVE</span><h1>Field notes<span style="color:var(--accent)">_</span></h1><p class="lead">Guide, ricerche e appunti operativi sulla cybersecurity.</p></section><section class="section"><div class="grid">{articles.map(a=><a class="entry" href={`/articoli/${a.id}/`}><span class="tag">{a.data.category||'Research'}</span><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="meta">{a.data.date?.toLocaleDateString('it-IT')} · READ ↗</span></a>)}</div>{articles.length===0&&<p>Non ci sono articoli pubblicati.</p>}</section></div></Site>