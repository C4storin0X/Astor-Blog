---
import Site from '../../layouts/Site.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>data.status==='Published')).sort((a,b)=>(b.data.date?.getTime()||0)-(a.data.date?.getTime()||0));
---
<Site title="Articoli"><div class="shell"><section class="page-head"><span class="eyebrow">KNOWLEDGE BASE</span><h1>Articoli e ricerche</h1><p class="lead">Guide operative, casi di studio e approfondimenti di cybersecurity.</p></section><section class="section"><div class="grid">{articles.map(a=><a class="card" href={`/articoli/${a.id}/`}><div class="cover">{a.data.cover?<img src={a.data.cover} alt={`Copertina: ${a.data.title}`} loading="lazy"/>:<span class="cover-mark">ASTOR / RESEARCH</span>}</div><div class="card-body"><span class="tag">{a.data.category||'Research'}</span><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="meta">{a.data.date?.toLocaleDateString('it-IT')} · LEGGI ↗</span></div></a>)}</div>{articles.length===0&&<p class="empty">Nessun articolo pubblicato.</p>}</section></div></Site>