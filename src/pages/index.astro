---
import Site from '../layouts/Site.astro';
import {Card,Button,Pill} from '@eliancodes/brutal-ui';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>data.status==='Published')).sort((a,b)=>(b.data.date?.getTime()||0)-(a.data.date?.getTime()||0)).slice(0,3);
const tools=(await getCollection('tools')).slice(0,4);
---
<Site title="Home" description="Cybersecurity, threat intelligence e risorse operative"><div class="bg-pink-theme p-6 md:p-10"><div class="cyber-layout"><section class="grid md:grid-cols-8 gap-8 mt-4"><div class="md:col-span-4"><Card><div class="flex flex-col justify-between items-start gap-5"><p class="text-4xl md:text-6xl lg:text-7xl font-black mt-4" style="font-family:Outfit,Arial,sans-serif">Understand systems.<br/><span class="text-emerald-800">Defend better.</span></p><p class="text-xl md:text-3xl" style="font-family:Outfit,Arial,sans-serif">Cybersecurity, field notes, investigation & resources.</p><Button target="_self" href="/articoli/">Leggi gli articoli →</Button></div></Card></div><div class="md:col-span-2"><Card><h2 class="text-3xl md:text-4xl mb-8" style="font-family:'DM Serif Text',Georgia,serif">Explore by topic</h2><div class="flex flex-wrap gap-3">{['SOC','DFIR','OSINT','Threat Intelligence','Network','OT/ICS'].map(tag=><Pill><span style="font-family:Sanchez,Georgia,serif">{tag}</span></Pill>)}</div></Card></div><div class="md:col-span-2"><Card><h2 class="text-3xl md:text-4xl mb-5" style="font-family:'DM Serif Text',Georgia,serif">The project</h2><p>Appunti verificabili, strumenti operativi e risorse di sicurezza informatica in un unico posto.</p><div class="mt-6"><Button target="_self" href="/tools/">Cyber Tools →</Button></div></Card></div></section><section class="mt-10"><Card><div class="flex flex-wrap items-start justify-between gap-4 mb-8"><h2 class="text-4xl md:text-6xl" style="font-family:'DM Serif Text',Georgia,serif">Recent blogposts</h2><Button target="_self" href="/articoli/">Tutti gli articoli →</Button></div><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">{articles.map(a=><a class="cyber-card block" href={`/articoli/${a.id}/`}><span class="text-sm uppercase font-bold">{a.data.category||'Research'}</span><h3 class="text-2xl font-bold my-4">{a.data.title}</h3><p>{a.data.description}</p><p class="text-sm mt-6">Leggi articolo ↗</p></a>)}{articles.length===0&&<p>Nessun articolo pubblicato.</p>}</div></Card></section><section class="mt-10 mb-6"><Card><div class="flex flex-wrap justify-between items-center gap-4 mb-8"><h2 class="text-4xl md:text-6xl" style="font-family:'DM Serif Text',Georgia,serif">Cyber Toolkit</h2><Button target="_self" href="/tools/">Esplora gli strumenti →</Button></div><div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">{tools.map(t=><a class="cyber-card" href={t.data.url} target="_blank" rel="noopener noreferrer"><span class="text-xs font-bold uppercase">{t.data.category||'Tools'}</span><h3 class="text-2xl font-bold my-4">{t.data.title}</h3><p>{t.data.description}</p></a>)}</div></Card></section></div></div></Site>