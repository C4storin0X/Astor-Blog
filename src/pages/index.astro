---
import Site from '../layouts/Site.astro';
import {getCollection} from 'astro:content';
const allArticles=await getCollection('articles',({data})=>data.status==='Published');
const articles=allArticles.sort((a,b)=>(b.data.date?.getTime()||0)-(a.data.date?.getTime()||0)).slice(0,3);
const allTools=await getCollection('tools');
const tools=allTools.slice(0,3);
---
<Site title="Home" description="Cybersecurity research, appunti tecnici e catalogo risorse">
<section class="hero wrap"><div class="hero-grid"><div><span class="eyebrow">// CYBERSECURITY · RESEARCH · KNOWLEDGE</span><h1>UNDERSTAND<br/>SYSTEMS.<br/><strong>DEFEND BETTER.</strong></h1><p class="lead">Analisi tecniche, Threat Intelligence e strumenti operativi. Un laboratorio personale per imparare, investigare e documentare.</p><div class="buttons"><a class="button" href="/articoli/">Esplora articoli ↗</a><a class="button alt" href="/tools/">Cyber Tools →</a></div></div><aside class="window hero-aside"><div class="window-head">● ● ● &nbsp; SYSTEM.INFO</div><div class="window-content"><span class="eyebrow">[ KNOWLEDGE INDEX ]</span><div class="status"><span>Published articles</span><b>{allArticles.length}</b></div><div class="status"><span>Curated tools</span><b>{allTools.length}</b></div><div class="status"><span>Focus</span><b>SOC / DFIR</b></div><div class="status"><span>Status</span><b>ONLINE_</b></div></div></aside></div></section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">01 // KNOWLEDGE BASE</span><h2>Recent field notes</h2></div><a class="button alt" href="/articoli/">Tutti gli articoli →</a></div><div class="grid">{articles.map(a=><a class="entry" href={`/articoli/${a.id}/`}><span class="tag">{a.data.category||'Research'}</span><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="meta">READ ARTICLE ↗</span></a>)}</div>{articles.length===0&&<p>Non ci sono articoli pubblicati.</p>}</section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">02 // TOOL LIBRARY</span><h2>Cyber Tools</h2></div><a class="button alt" href="/tools/">Catalogo completo →</a></div><div class="grid">{tools.map(t=><a class="entry" href={t.data.url} target="_blank" rel="noopener noreferrer"><span class="tag">{t.data.category||'Tool'}</span><h3>{t.data.title}</h3><p>{t.data.description}</p><span class="meta">OPEN RESOURCE ↗</span></a>)}</div></section></Site>