---
import Site from '../layouts/Site.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>data.status==='Published')).sort((a,b)=>(b.data.date?.getTime()||0)-(a.data.date?.getTime()||0));
const [featured,...recent]=articles;
const tools=(await getCollection('tools')).slice(0,3);
const topics=['SOC','DFIR','OSINT','Threat Intelligence','Network Security','OT-ICS','Malware Analysis','Tutorial'];
---
<Site title="Home" description="Articoli di cybersecurity, tutorial e libreria di strumenti"><section class="hero shell"><span class="eyebrow">FIELD NOTES / THREAT INTELLIGENCE / CYBER TOOLS</span><h1>Understand systems.<br/><em>Defend better.</em></h1><p class="lead">Analisi tecniche, tutorial e risorse operative per la sicurezza informatica. Un archivio curato, pensato per trasformare lo studio in conoscenza applicabile.</p><div class="actions"><a class="button" href="/articoli/">Leggi gli articoli →</a><a class="button ghost" href="/tools/">Esplora i tool ↗</a></div></section>
{featured&&<section class="section shell"><div class="section-heading"><div><span class="eyebrow">IN EVIDENZA</span><h2>Articolo selezionato</h2></div></div><a class="feature" href={`/articoli/${featured.id}/`}><div class="cover">{featured.data.cover?<img src={featured.data.cover} alt={`Copertina: ${featured.data.title}`} loading="lazy"/>:<span class="cover-mark">ASTOR / RESEARCH</span>}</div><div class="feature-body"><span class="tag">{featured.data.category||'Cybersecurity'}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><span class="meta">{featured.data.date?.toLocaleDateString('it-IT')} · LEGGI ARTICOLO ↗</span></div></a></section>}
<section class="section shell"><div class="section-heading"><div><span class="eyebrow">KNOWLEDGE BASE</span><h2>Ultimi articoli</h2></div><a class="section-link" href="/articoli/">Tutti gli articoli →</a></div><div class="grid">{recent.slice(0,6).map(a=><a href={`/articoli/${a.id}/`} class="card"><div class="cover">{a.data.cover?<img src={a.data.cover} alt={`Copertina: ${a.data.title}`} loading="lazy"/>:<span class="cover-mark">ASTOR / BLOG</span>}</div><div class="card-body"><span class="tag">{a.data.category||'Research'}</span><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="meta">{a.data.date?.toLocaleDateString('it-IT')}</span></div></a>)}</div>{articles.length===0&&<p class="empty">Nessun articolo pubblicato.</p>}</section>
<section class="section shell"><div class="section-heading"><div><span class="eyebrow">ARGOMENTI</span><h2>Esplora per categoria</h2></div></div><div class="topic-grid">{topics.map(t=><a class="topic" href="/articoli/">{t} ↗</a>)}</div></section>
<section class="section shell"><div class="section-heading"><div><span class="eyebrow">SECURITY TOOLKIT</span><h2>Risorse selezionate</h2></div><a class="section-link" href="/tools/">Catalogo completo →</a></div><div class="grid">{tools.map(t=><a class="card tool" href={t.data.url} target="_blank" rel="noopener noreferrer"><span class="tag">{t.data.category||'Tool'}</span><h3>{t.data.title}</h3><p>{t.data.description}</p><span class="meta">OPEN TOOL ↗</span></a>)}</div></section></Site>