---
import Site from '../../layouts/Site.astro';
import {getCollection} from 'astro:content';
const tools=(await getCollection('tools')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const categories=[...new Set(tools.map(t=>t.data.category).filter(Boolean))];
---
<Site title="Cyber Tools"><div class="wrap"><section class="page-head"><span class="eyebrow">02 // SECURITY TOOLKIT</span><h1>Cyber tools<span style="color:var(--accent)">_</span></h1><p class="lead">Catalogo di risorse OSINT, Threat Intelligence, DFIR e networking. Ricerca per nome, funzione o categoria.</p></section><section class="section"><input id="search" class="search" type="search" placeholder="> search tools..." aria-label="Cerca strumenti"/><div class="chips"><button class="chip" data-category="all" aria-pressed="true">Tutti</button>{categories.map(c=><button class="chip" data-category={c} aria-pressed="false">{c}</button>)}</div><div class="grid">{tools.map(t=><article class="entry tool" data-category={t.data.category||''} data-search={`${t.data.title} ${t.data.description||''} ${t.data.category||''}`.toLowerCase()}><span class="tag">{t.data.category||'Tool'}</span><h3>{t.data.title}</h3><p>{t.data.description}</p><span class="meta">{t.data.access||'Web'} · {t.data.pricing||'Non verificato'} {t.data.favorite?'★':''}</span><a class="button alt" href={t.data.url} target="_blank" rel="noopener noreferrer">Apri risorsa ↗</a></article>)}</div><p id="no-results" hidden>Nessun tool trovato.</p></section></div><script is:inline>
const input=document.querySelector('#search'),chips=[...document.querySelectorAll('.chip')],cards=[...document.querySelectorAll('.tool')],empty=document.querySelector('#no-results');let selected='all';const update=()=>{let q=input.value.trim().toLowerCase(),n=0;cards.forEach(card=>{let show=(selected==='all'||card.dataset.category===selected)&&card.dataset.search.includes(q);card.hidden=!show;if(show)n++});empty.hidden=n!==0};input?.addEventListener('input',update);chips.forEach(chip=>chip.addEventListener('click',()=>{selected=chip.dataset.category;chips.forEach(c=>c.setAttribute('aria-pressed',String(c===chip)));update()}));
</script></Site>