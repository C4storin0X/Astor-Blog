---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';
const tools=(await getCollection('tools')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const categories=[...new Set(tools.map(t=>t.data.category).filter(Boolean))];
---
<Site title="Cyber Tools"><section class="pagehead"><div class="shell"><span class="eyebrow">Curated resources</span><h1>Cyber Tools</h1><p class="lead">Strumenti e servizi per OSINT, Threat Intelligence, DFIR e analisi tecniche. Cerca per nome o funzione.</p></div></section><section class="section shell"><input id="search" class="searchbar" type="search" placeholder="Cerca nome, descrizione, categoria..." aria-label="Cerca strumenti"/><div class="filterbar"><button class="chip active" data-filter="all">Tutti</button>{categories.map(c=><button class="chip" data-filter={c}>{c}</button>)}</div><div class="grid" id="tool-grid">{tools.map(t=><article class="tile tool" data-category={t.data.category||''} data-search={`${t.data.title} ${t.data.description||''} ${t.data.category||''}`.toLowerCase()}><span class="tag">{t.data.category||'Tool'}</span><h3>{t.data.title}</h3><p>{t.data.description}</p><div class="meta">{t.data.access||'Web'} · {t.data.pricing||'Da verificare'} {t.data.favorite?'★':''}</div><a class="inline-link" href={t.data.url} target="_blank" rel="noopener noreferrer">Apri risorsa ↗</a></article>)}</div><p id="no-results" class="empty" hidden>Nessuno strumento trovato.</p></section><script is:inline>
const input=document.querySelector('#search');const chips=[...document.querySelectorAll('.chip')];const cards=[...document.querySelectorAll('.tool')];const empty=document.querySelector('#no-results');let category='all';function refresh(){const q=(input.value||'').trim().toLowerCase();let count=0;cards.forEach(card=>{const show=(category==='all'||card.dataset.category===category)&&card.dataset.search.includes(q);card.hidden=!show;if(show)count++});empty.hidden=count>0;}input?.addEventListener('input',refresh);chips.forEach(chip=>chip.addEventListener('click',()=>{category=chip.dataset.filter;chips.forEach(c=>c.classList.toggle('active',c===chip));refresh()}));
</script></Site>