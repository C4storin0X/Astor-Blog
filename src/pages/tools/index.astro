---
import Site from '../../layouts/Site.astro';
import {Card} from '@eliancodes/brutal-ui';
import {getCollection} from 'astro:content';
const tools=(await getCollection('tools')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const categories=[...new Set(tools.map(t=>t.data.category).filter(Boolean))];
---
<Site title="Cyber Tools"><div class="bg-purple-theme p-6 md:p-10 min-h-screen"><div class="cyber-layout"><Card><h1 class="text-5xl md:text-7xl mb-4" style="font-family:'DM Serif Text',Georgia,serif">Cyber Tools</h1><p class="text-lg mb-8">Archivio di risorse OSINT, Threat Intelligence, DFIR e analisi.</p><input id="search" type="search" class="cyber-search" placeholder="Cerca nome, categoria o funzione..." aria-label="Cerca strumenti"/><div class="flex flex-wrap gap-3 mt-7 mb-8"><button class="cyber-chip" data-category="all" aria-pressed="true">Tutti</button>{categories.map(c=><button class="cyber-chip" data-category={c} aria-pressed="false">{c}</button>)}</div><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{tools.map(t=><article class="cyber-card tool" data-category={t.data.category||''} data-search={`${t.data.title} ${t.data.description||''} ${t.data.category||''}`.toLowerCase()}><span class="text-xs font-extrabold uppercase">{t.data.category||'Tool'}</span><h2 class="text-2xl font-black mt-3 mb-5">{t.data.title}</h2><p>{t.data.description}</p><p class="text-sm mt-5">{t.data.access||'Web'} · {t.data.pricing||'Non verificato'} {t.data.favorite?'★':''}</p><p class="mt-6"><a href={t.data.url} target="_blank" rel="noopener noreferrer" class="cyber-link">Apri tool ↗</a></p></article>)}</div><p id="no-results" hidden class="mt-8">Nessuno strumento trovato.</p></Card></div></div><script is:inline>
const input=document.querySelector('#search'),chips=[...document.querySelectorAll('.cyber-chip')],cards=[...document.querySelectorAll('.tool')],empty=document.querySelector('#no-results');let selected='all';const update=()=>{let q=input.value.trim().toLowerCase(),n=0;cards.forEach(card=>{let show=(selected==='all'||card.dataset.category===selected)&&card.dataset.search.includes(q);card.hidden=!show;if(show)n++});empty.hidden=n!==0};input?.addEventListener('input',update);chips.forEach(chip=>chip.addEventListener('click',()=>{selected=chip.dataset.category;chips.forEach(c=>c.setAttribute('aria-pressed',String(c===chip)));update()}));
</script></Site>