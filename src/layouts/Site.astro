---
import '../styles/global.css';
const {title='Astor Blog',description='Cybersecurity & research'}=Astro.props;const path=Astro.url.pathname;
---
<!doctype html><html lang="it" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#080f17"/><title>{title} | Astor Blog</title><script is:inline>try{const preference=localStorage.getItem("astor-theme");document.documentElement.dataset.theme=preference==="light"?"light":"dark";}catch{document.documentElement.dataset.theme="dark";}</script><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><header class="header"><div class="shell head-inner"><a href="/" class="brand">ASTOR<span>.</span>BLOG</a><nav class="nav" aria-label="Menu principale"><a href="/" aria-current={path==='/'?'page':undefined}>Home</a><a href="/articoli/" aria-current={path.startsWith('/articoli/')?'page':undefined}>Articoli</a><a href="/tools/" aria-current={path.startsWith('/tools/')?'page':undefined}>Cyber Tools</a></nav><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Attiva tema chiaro" aria-pressed="false" title="Cambia tema"><span class="theme-symbol" aria-hidden="true">☀</span><span class="theme-label">Light</span></button></div></header><main><slot/></main><footer class="footer"><div class="shell foot-inner"><span>© {new Date().getFullYear()} Astor Blog · Cybersecurity & Research</span><a href="https://github.com/C4storin0X/Astor-Blog" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></footer><script is:inline>(()=>{const button=document.getElementById("theme-toggle");const meta=document.querySelector('meta[name="theme-color"]');const root=document.documentElement;if(!button)return;function update(){const light=root.dataset.theme==="light";button.setAttribute("aria-label",light?"Attiva tema scuro":"Attiva tema chiaro");button.setAttribute("aria-pressed",String(light));button.querySelector(".theme-symbol").textContent=light?"☾":"☀";button.querySelector(".theme-label").textContent=light?"Dark":"Light";if(meta)meta.setAttribute("content",light?"#f2f6fb":"#080f17");}button.addEventListener("click",()=>{const next=root.dataset.theme==="light"?"dark":"light";root.dataset.theme=next;try{localStorage.setItem("astor-theme",next)}catch{}update();});update();})();</script></body></html>